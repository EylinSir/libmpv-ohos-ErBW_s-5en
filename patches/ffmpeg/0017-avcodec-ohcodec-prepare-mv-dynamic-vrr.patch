+static int oh_decode_policy_error(AVCodecContext *avctx, const char *feature,
+                                  OH_AVErrCode err, bool *failed)
+{
+    if (err == AV_ERR_OK)
+        return 0;
+    if (oh_decode_policy_rejected(err)) {
+        if (failed)
+            *failed = true;
+        av_log(avctx, AV_LOG_WARNING,
+               "[OHCodecPolicy] %s=request-rejected error=%d\n", feature, err);
+        return 0;
+    }
+    av_log(avctx, AV_LOG_ERROR,
+           "[OHCodecPolicy] %s=decoder-error error=%d\n", feature, err);
+    return ff_oh_err_to_ff_err(err);
+}
