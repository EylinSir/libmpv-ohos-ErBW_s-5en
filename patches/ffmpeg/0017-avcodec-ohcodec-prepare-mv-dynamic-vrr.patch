+static int oh_decode_restore_full(AVCodecContext *avctx)
+{
+    OHCodecDecContext *s = avctx->priv_data;
+    OH_AVFormat *format = OH_AVFormat_Create();
+    if (!format) {
+        s->full_restore_error = AVERROR(ENOMEM);
+        return s->full_restore_error;
+    }
+    bool valid = OH_AVFormat_SetIntValue(format, s->keys.retention_mode,
+                                        OH_FRAME_RETENTION_MODE_FULL);
+    OH_AVErrCode err = valid ? OH_VideoDecoder_SetParameter(s->dec, format)
+                            : AV_ERR_UNKNOWN;
+    OH_AVFormat_Destroy(format);
+    if (err != AV_ERR_OK) {
+        // Do not pretend frame dropping stopped if FULL could not be restored.
+        av_log(avctx, AV_LOG_ERROR,
+               "[OHCodecPolicy] smart-fluency=full-restore-failed error=%d\n", err);
+        s->full_restore_error = ff_oh_err_to_ff_err(err);
+        return s->full_restore_error;
+    }
+    s->smart_fluency_active = false;
+    av_log(avctx, AV_LOG_WARNING,
+           "[OHCodecPolicy] smart-fluency=disabled retention=full\n");
+    return 0;
+}
