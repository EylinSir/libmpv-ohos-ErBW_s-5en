+static int oh_decode_update_vrr_policy(AVCodecContext *avctx)
+{
+    OHCodecDecContext *s = avctx->priv_data;
+    if (!s->vrr_pending || !s->dec)
+        return 0;
+    s->vrr_pending = false;
+    if (s->vrr_failed || !s->keys.enable_vrr)
+        return 0;
+    const double fps = s->source_frame_rate *
+                       fmax(s->requested_playback_speed, 1.0);
+    if (s->vrr_enabled && (!s->keys.frame_rate || fps <= 0.0))
+        return 0;
+    OH_AVFormat *format = OH_AVFormat_Create();
+    if (!format)
+        return AVERROR(ENOMEM);
+    bool valid = OH_AVFormat_SetIntValue(format, s->keys.enable_vrr,
+                                        s->vrr_enabled);
+    if (s->vrr_enabled)
+        valid = valid && OH_AVFormat_SetDoubleValue(format, s->keys.frame_rate, fps);
+    OH_AVErrCode err = valid ? OH_VideoDecoder_SetParameter(s->dec, format)
+                            : AV_ERR_UNKNOWN;
+    OH_AVFormat_Destroy(format);
+    if (err == AV_ERR_OK)
+        s->vrr_applied = s->vrr_enabled;
+    if (err == AV_ERR_OK && s->vrr_enabled && s->preroll)
+        s->playback_policy_pending = true; // Restore the preroll decode-rate floor.
+    av_log(avctx, AV_LOG_WARNING,
+           "[OHCodecPolicy] vrr=%s mode=%s fps=%.3f set-parameter=%d "
+           "screen-effect=platform-dependent\n",
+           err != AV_ERR_OK ? "request-failed" :
+               (s->vrr_enabled ? "requested" : "disabled"),
+           s->direct_surface_output ? "direct-surface" : "gpu-buffer", fps, err);
+    int ret = oh_decode_policy_error(avctx, "vrr", err, &s->vrr_failed);
+    if (ret < 0 || err == AV_ERR_OK || !s->vrr_enabled)
+        return ret;
+    // A rejected enable may have been partially applied. Best-effort off only;
+    // never reset/recreate a running decoder for an optional VRR request.
+    format = OH_AVFormat_Create();
+    if (!format)
+        return AVERROR(ENOMEM);
+    valid = OH_AVFormat_SetIntValue(format, s->keys.enable_vrr, 0);
+    err = valid ? OH_VideoDecoder_SetParameter(s->dec, format) : AV_ERR_UNKNOWN;
+    OH_AVFormat_Destroy(format);
+    if (err == AV_ERR_OK)
+        s->vrr_applied = 0;
+    av_log(avctx, AV_LOG_WARNING,
+           "[OHCodecPolicy] vrr=request-updates-stopped last-applied=%d off-result=%d\n",
+           s->vrr_applied, err);
+    return oh_decode_policy_error(avctx, "vrr-off", err, NULL);
+}
